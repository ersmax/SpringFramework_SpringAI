<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration xmlns="http://www.hibernate.org/xsd/orm/cfg">
    <session-factory>
        <!-- Database connection properties: driver you work with, URL, user and pwd -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/demo</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">password</property>

        <!-- Hibernate properties -->
        <!-- hibernate map to dll: create a table when you don't find one, or update with new schema if table is already there -->
        <property name="hibernate.hbm2ddl.auto">update</property>
        <!-- inform the dialect used -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
        
        <!-- Show and format the query in execution -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        
        <!-- Specify you use L2 cache -->
        <property name="hibernate.cache.use_second_level_cache">true</property>
        <!-- Factory of JCache -->
        <property name="hibernate.cache.region.factory_class">org.hibernate.cache.jcache.internal.JCacheRegionFactory</property>
        <!-- Provider of L2 cache: Ehcache -->
        <property name="hibernate.jakarta.cache.provider">org.ehcache.jsr107.EhcacheCachingProvider</property>


    </session-factory>
</hibernate-configuration>
